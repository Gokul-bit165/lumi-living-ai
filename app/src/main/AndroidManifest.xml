<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Movement signal for the context engine (core/common/context boundary). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Special-access permission: granted via Settings, not a runtime dialog.
         Powers the Focus Guardian's app-usage signal; app must work without it. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />

    <application
        android:name=".LivingAiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LivingAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LivingAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
